# Tikjap AI — environment variables
# Copy to .env.local and adjust as needed. All values are optional.

# demo | live — demo uses the bundled mock backend (seeded accounts)
NEXT_PUBLIC_APP_MODE=demo

# Display name shown across the UI
NEXT_PUBLIC_APP_NAME=Tikjap AI

# Show the pricing section on the landing page
NEXT_PUBLIC_BILLING_ENABLED=true

# Base URL of the API. In demo mode this resolves to the bundled handlers.
# Point this at your real backend in live mode, e.g. https://api.example.com/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1