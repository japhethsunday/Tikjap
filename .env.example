# Tikjap AI — environment variables
# Copy to .env.local and fill in the Supabase values.

# demo | live — demo seeds the demo@tikjap.dev and admin@tikjap.dev accounts
NEXT_PUBLIC_APP_MODE=demo

# Display name shown across the UI
NEXT_PUBLIC_APP_NAME=Tikjap AI

# Show the pricing section on the landing page
NEXT_PUBLIC_BILLING_ENABLED=true

# Base URL of the API (route handlers in this repo)
NEXT_PUBLIC_API_BASE_URL=/api/v1

# --- Supabase (required) ---
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → service_role secret key (server-only, never expose)
SUPABASE_SERVICE_ROLE_KEY=

# --- Inference gateway (server-only, never expose) ---
# OpenAI-compatible chat-completions endpoint used by the backend provider.
AI_GATEWAY_BASE_URL=https://integrate.api.nvidia.com/v1

# Bearer key for the gateway. Without it, chat falls back to the bundled
# reference backend so the app still runs locally.
AI_GATEWAY_API_KEY=