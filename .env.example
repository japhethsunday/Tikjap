# Tikjap AI — environment variables
# Copy to .env.local and fill in the Supabase values.

# demo | live
#
# Demo mode seeds shared demo@tikjap.dev / admin@tikjap.dev accounts and
# publishes their passwords from /api/v1/public/info. It is ignored in
# production builds — never rely on it to gate anything.
NEXT_PUBLIC_APP_MODE=demo

# Display name shown across the UI
NEXT_PUBLIC_APP_NAME=Tikjap AI

# Show the pricing section on the landing page
NEXT_PUBLIC_BILLING_ENABLED=true

# Base URL of the API (route handlers in this repo)
NEXT_PUBLIC_API_BASE_URL=/api/v1

# --- Supabase (required) ---
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → service_role secret key (server-only, never expose)
SUPABASE_SERVICE_ROLE_KEY=

# --- Inference gateway (server-only, never expose) ---
# OpenAI-compatible chat-completions endpoint used by the backend provider.
AI_GATEWAY_BASE_URL=https://integrate.api.nvidia.com/v1

# Bearer key for the gateway. Without it, chat falls back to the bundled
# reference backend so the app still runs locally.
AI_GATEWAY_API_KEY=

# --- Tools (server-only, never expose) ---

# Web Search and Deep Research need one search provider. Set exactly one; the
# first configured wins. Without any of them both tools report themselves
# unavailable and their composer chips are disabled — they never fabricate
# results.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# Image Generation. An OpenAI-compatible /images/generations endpoint,
# authenticated with AI_GATEWAY_API_KEY above. Unset disables the tool.
IMAGE_GATEWAY_URL=
IMAGE_GATEWAY_MODEL=black-forest-labs/flux.1-schnell

# --- Scheduled prompts ---
# Shared secret for GET /api/cron/tick (sent as "Authorization: Bearer <value>").
# Required: with no value the endpoint returns 503 rather than running
# schedules for every user unauthenticated.
CRON_SECRET=
